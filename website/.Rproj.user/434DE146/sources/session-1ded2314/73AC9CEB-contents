> *Let us play around with the algebra:*

\begin{align*}
l(\beta_0, \dots, \beta_k \mid y_1, \dots , y_{n}, x_{1,1}, \dots, x_{1,k}, \dots, x_{n,1}, \dots, x_{n,k}) &= \prod_{i = 1}^n \left[ \exp{\left(\beta_0 + \sum_{j = 1}^k \beta_j x_{i, j}\right)} \right]^{y_i} \times \\
& \qquad\left[ \frac{1}{1 + \exp \left( \beta_0 + \sum_{j = 1}^k \beta_j x_{i, j} \right)} \right] \\
&= \prod_{i = 1}^n \frac{\left[ \exp{\left(\beta_0 + \sum_{j = 1}^k \beta_j x_{i, j}\right)} \right]^{y_i}}{1 + \exp \left( \beta_0 + \sum_{j = 1}^k \beta_j x_{i, j} \right)}.
