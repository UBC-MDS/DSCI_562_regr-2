> P(A \cap B \cap C^c) &= P(A \cap B) - P(A \cap B \cap C) \\
> &= 0.06 - 0.01 \\
> &= 0.05
> \end{align*}

> **7.4.** \begin{align*}
> P[(A \cup B \cup C)^c] &= 1 - P(A \cup B \cup C) \\
> &= 1 - [P(A) + P(B) + P(C) - P(A \cap B) - P(B \cap C) - P(A \cap C) + \\ & \quad \qquad P(A \cap B \cap C)] \\
> &= 1 - (0.12 + 0.07 + 0.05 - 0.06 - 0.01 - 0.04 + 0.01) \\
> &= 0.86.
> \end{align*}

> **7.5.** \begin{align*}
> P(A \cup B \cup C^c) =& P(A) + P(B) + P(C^c) - P(A \cap B) - P(B \cap C^c) - P(A \cap C^c) + \\ & \quad \qquad P(A \cap B \cap C^c) \\
> &= P(A) + P(B) + \underbrace{[1 - P(C)]}_{P(C^c)} - P(A \cap B) - \underbrace{[P(B) - P(B \cap C)]}_{P(B \cap C^c)} - \\
> & \quad \qquad \underbrace{[P(A) - P(A \cap C)]}_{P(A \cap C^c)} + \underbrace{[P(A \cap B) - P(A \cap B \cap C)]}_{P(A \cap B \cap C^c)} \\
> &= 0.12 + 0.07 + (1 - 0.05) - 0.06 - (0.07 - 0.01) - (0.12 - 0.04) + (0.06 - 0.01) \\
> &= 0.99.
